<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HyTik" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hytik_accent</item>
        <item name="colorPrimaryVariant">@color/hytik_primary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/hytik_secondary</item>
        <item name="colorSecondaryVariant">@color/hytik_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/tiktok_cyan</item>
        
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/card_bg_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/card_bg_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="CardStyle.HyTik" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_bg_dark</item>
    </style>
</resources>
