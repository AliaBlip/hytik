    <string name="settings_title">Pengaturan &amp; Panduan</string>
    <string name="guide_title">Cara Mengunduh dari TikTok:</string>
    <string name="guide_step_1">1. Buka aplikasi atau situs web TikTok.</string>
    <string name="guide_step_2">2. Pilih video atau slide foto yang ingin diunduh.</string>
    <string name="guide_step_3">3. Klik tombol Bagikan (Share) berbentuk panah di kanan bawah.</string>
    <string name="guide_step_4">4. Klik \"Salin Tautan\" (Copy Link).</string>
    <string name="guide_step_5">5. Buka kembali aplikasi HyTik, tautan akan otomatis terdeteksi atau tekan \"Tempel\".</string>
    <string name="pref_auto_paste_title">Deteksi Tautan Otomatis</string>
